<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================== -->
    <!-- Track List                                                 -->
    <!-- ========================================================== -->

    <template id="track_list" name="OXP Tracks">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5 o_wetrack_list">
                    <div class="row mb-4">
                        <div t-if="not tracks" class="col-lg-8">
                            <h1>OXP Talks</h1>
                            <p class="text-muted">
                                Browse all Odoo Experience talks.
                            </p>
                        </div>
                        <div class="col-lg-4">
                            <form
                                action="/oxp/tracks"
                                method="get"
                                class="d-flex"
                            >
                                <input
                                    type="search"
                                    name="search"
                                    t-att-value="search"
                                    class="form-control"
                                    placeholder="Search talks..."
                                />
                                <button
                                    type="submit"
                                    class="btn btn-primary ms-2"
                                >
                                    Search
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="row">
                        <t t-foreach="tracks" t-as="track">
                            <div class="col-lg-4 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <h5>
                                            <a t-att-href="'/oxp/tracks/%s' % track.id">
                                                <t t-out="track.name"/>
                                            </a>
                                        </h5>
                                        <div class="mt-3">
                                            <span
                                                t-foreach="track.tag_ids"
                                                t-as="tag"
                                                class="badge text-bg-secondary me-1"
                                            >
                                                <t t-out="tag.name"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="card-footer">
                                        <button
                                            class="btn btn-outline-danger o_wetrack_wishlist"
                                            t-att-data-track-id="track.id">
                                            <t t-if="track.is_reminder_on">
                                                <i class="fa fa-regular fa-heart"/>
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-heart fa-solid"/>
                                            </t>
                                            Wishlist
                                        </button>
                                        <a
                                            class="btn btn-outline-danger o_wetrack_feedback"
                                            t-attf-href="/oxp/tracks/{{track.id}}/feedback"
                                            t-att-data-track-id="track.id">
                                                <i class="fa fa-feedback"/>
                                            Feedback
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <t t-call="website.pager"/>
                </section>
            </div>
        </t>
    </template>

    <!-- ========================================================== -->
    <!-- Track Detail                                               -->
    <!-- ========================================================== -->

    <template id="track_detail" name="OXP Track Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row">
                        <div class="col-lg-12 d-flex align-items-center">
                            <div t-if="track.partner_id.avatar_128" t-field="track.partner_id.avatar_128"
                                t-options="{'widget': 'image', 'class': 'me-2 rounded-circle', 'max_height': '96', 'max_width': '96'}"/>
                            <h1 t-field="track.name" class="me-3" />
                        </div>
                        <div class="col-lg-8 mt-4">
                            <div class="card">
                                <div class="card-body">
                                    <h5>Information</h5>
                                    <ul class="list-unstyled">
                                        <li t-if="track.event_id">
                                            <strong>Event</strong><br/>
                                            <span t-field="track.event_id"/>
                                        </li>
                                        <li
                                            class="mt-3"
                                            t-if="track.location_id"
                                        >
                                            <strong>Location</strong><br/>
                                            <span t-field="track.location_id"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div
                                class="mt-4"
                                t-field="track.description"
                            />
                        </div>
                    </div>
                    <hr class="my-5"/>
                    <h3>Related Talks</h3>
                    <div class="row">
                        <t
                            t-foreach="related_tracks"
                            t-as="related"
                        >
                            <div class="col-md-3">
                                <a
                                    t-att-href="'/oxp/tracks/%s' % related.id"
                                    class="text-decoration-none"
                                >
                                    <div class="card">
                                        <div class="card-body">
                                            <h6>
                                                <t t-out="related.name"/>
                                            </h6>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="track_feedback" name="OXP Track Feedback">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <h3 class="mb-4">
                        Give Feedback
                    </h3>
                    <!-- ===================================================== -->
                    <!-- Success Message                                       -->
                    <!-- ===================================================== -->
                    <div
                        t-if="request.params.get('feedback') == 'success'"
                        class="alert alert-success"
                        role="alert"
                    >
                        <i class="fa fa-check-circle me-2"/>
                        Thank you! Your feedback has been submitted.
                    </div>
                    <!-- ===================================================== -->
                    <!-- Error Message                                         -->
                    <!-- ===================================================== -->
                    <div
                        t-if="request.params.get('feedback_error')"
                        class="alert alert-danger"
                        role="alert"
                    >
                        Please fill all required fields.
                    </div>
                    <form
                        method="post"
                        t-att-action="'/oxp/tracks/%s/feedback' % track.id"
                    >
                        <!-- CSRF Token -->
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Name *
                                </label>
                                <input
                                    class="form-control"
                                    type="text"
                                    name="name"
                                    required="required"
                                />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Email
                                </label>
                                <input
                                    class="form-control"
                                    type="email"
                                    name="email"
                                />
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">
                                Comment
                            </label>
                            <textarea
                                class="form-control"
                                name="comment"
                                rows="5"
                                placeholder="Share your thoughts about this talk..."
                            />
                        </div>
                        <button
                            class="btn btn-primary"
                            type="submit"
                        >
                            Submit Feedback
                        </button>
                    </form>
                </section>
            </div>
        </t>
    </template>

</odoo>
