<odoo>

<!-- ======   Sub-Template: Posts list : Posts Cover  ====================== -->
<template id="service_cover_image">
    <t t-if="not opt_service_list_view" t-set="classes" t-value="'card-img-top mb-2'"/>
    <t t-if="opt_service_list_view" t-set="classes" t-value="'o_wblog_post_cover_nocard'"/>

    <a t-attf-href="/service/#{slug(service)}"
       t-attf-class="text-decoration-none d-block #{classes or 'mb-2'}"
       t-att-style="not service.website_published and 'opacity:0.6;'">

        <t t-call="website.record_cover">
            <t t-set="_record" t-value="service"/>
            <t t-set="additionnal_classes" t-value="'o_list_cover o_not_editable'"/>
        </t>
    </a>
</template>

<template id="service_heading">
    <a t-attf-href="/service/#{slug(service)}"
       t-field="service.name"
       t-attf-class="card-title d-block text-reset text-decoration-none o_blog_post_title my-0 #{'h3' if opt_service_list_view else 'h6'}">
       Untitled Service
   </a>
</template>

<template id="service_nav" name="Service Navbar Template">
    <nav t-attf-class="navbar navbar-expand-lg navbar-light oe_navbar pt-4 pb-0 px-0 #{additionnal_classes}">
        <div t-attf-class="container gap-2 w-100 #{wblog_nav_offcanvas and 'flex-nowrap' or 'flex-wrap flex-sm-nowrap'}">
            <!-- 'Search Box' -->
            <input type="search" name="search" t-att-class="'search-query form-control oe_search_box %s %s' % (_input_classes or '', '' if default_style else 'border-0 bg-light')" t-att-placeholder="placeholder if placeholder else search_placeholder" t-att-value="search"/>
            <button class="btn btn-primary ms-2 oe_search_button" t-on-click="onSearch">
                <i class="fa fa-search"/>
            </button>
        </div>
    </nav>
</template>

<template id="service_tags" name="Service Tags">
    <t t-if="service.tag_ids">
        <div class="o_service_tags mt-2">
            <t t-foreach="service.tag_ids" t-as="tag" t-key="tag.id">
                <span class="badge bg-secondary me-1 mb-1">
                    <a t-attf-href="/service/tag/#{slug(tag)}" class="text-decoration-none text-white" t-out="tag.name"></a>
                </span>
            </t>
        </div>
    </t>
</template>

<template id="services" name="Services">
    <t t-call="website.layout">
        <t t-set="opt_service_list_view" t-value="is_view_active('website_local_services.opt_service_list_view')"/>
        <div id="wrap" class="js_services website_services">
            <t t-call="website_local_services.service_nav">
                <t t-set="search" t-value="original_search or search"/>
                <t t-set="additional_classes" t-value="'mt-3'"/>
            </t>
            <section class="container py-4">
                <!-- Grid-View/List View Design decided based on option -->
                <t t-set="colWidth" t-value="'px-2 col-sm-12 col-lg-12 col-xl-12'"/>
                <t t-if="not opt_service_list_view">
                    <t t-set="colWidth" t-value="'px-2 col-sm-6 col-lg-4 col-xl-3'"/>
                </t>
                <!-- List-View Design, add <hr> after post -->
                <div t-if="opt_service_list_view and not blog_post_last" class="col-12 mt-2 mb-5 px-2"><hr/></div>
                <div id="o_services_index_content"
                    t-attf-class="#{opt_service_list_view} and 'o_services_list' or 'o_services_grid'"
                    t-att-data-tags-options="opt_service_tags == 'show' and 'show' or 'hide'">
                    <div t-attf-class="justify-content-center">
                        <div id="o_service_loop_container" t-attf-class="row #{'o_container_small mx-0' if opt_blog_list_view else ''}">
                            <t t-foreach="services" t-as="service">
                                <!-- Assign 'colWidth': 'col-12' is default for List-View and mobile -->
                                <div t-att-class="colWidth">
                                    <div class="o_service_card card pb-4">
                                        <article t-attf-class="o_service position-relative" name="service">
                                            <div class="card-img-top o_cover_image_card">
                                                <t t-call="website_local_services.service_cover_image"/>
                                            </div>
                                            <div class="card-body">
                                                <t t-call="website_local_services.service_heading"/>
                                                <t t-if="opt_service_tags == 'show'" t-call="website_local_services.service_tags"/>
                                            </div>
                                        </article>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </section>
            <div class="oe_structure oe_empty oe_structure_not_nearest"
                id="oe_structure_services_footer"
                t-att-data-editor-sub-message="'Drop Content Here'"/>
        </div>
    </t>
</template>

<template id="opt_service_list_view" inherit_id="website_local_services.services" active="False" name="'Cards' Design"/>

<template id="service_providers" name="Service Providers Page">
    <t t-call="website.layout">
        <section class="s_providers pt64 pb64 o_colored_level" data-name="Items" style="position: relative;">
            <div class="container-fluid">
                <div class="row s_nb_column_fixed">
                    <t t-foreach="providers" t-as="provider">
                        <div data-name="Card" class="col-6 col-lg-2">
                            <div class="s_card card o_cc o_cc1 o_colored_level o_card_img_top" data-name="Card">
                                <div class="card-img-top o_cover_image_card">
                                    <a aria-label="Link to product" t-attf-href="/service/{{ provider.id }}">
                                        <img t-attf-src="/web/image/service.provider/{{ provider.id }}/image_1920/240x240"/>
                                    </a>
                                </div>
                                <div class="card-body">
                                    <h3 class="card-title h5-fs" style="text-align: center;">
                                        <span class="base-fs">
                                            <a t-attf-href="/service/provider/#{slug(provider)}" class="btn btn-primary" t-out="provider.name"></a>
                                        </span>
                                        <br/>
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </section>
    </t>
</template>

<template id="add_provider" name="Provider">
    <t t-call="website.layout">
        <section class="pt64 pb64 o_colored_level" style="position: relative;">
            <div class="container-fluid">
                <div class="row s_nb_column_fixed">
                    <div class="col-lg-12">
                        <h1>Add Service Provider</h1>
                        <form t-attf-action="/service/{{ service.id }}/submit_provider" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="form-group">
                                <label for="provider_name">Provider Name</label>
                                <input type="text" class="form-control" id="provider_name" name="name" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="provider_email">Email</label>
                                <input type="email" class="form-control" id="provider_email" name="email" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="provider_phone">Phone</label>
                                <input type="tel" class="form-control" id="provider_phone" name="phone" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="provider_description">Description</label>
                                <textarea class="form-control" id="provider_description" name="profile_description" rows="4"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary mt-3">Add Provider</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </t>
</template>

<template id="service_provider_detail" name="Service Providers Page">
    <t t-call="website.layout">
        <!-- Title -->
        <!-- <h1 class="text-center mb-4">Local Service Provider</h1> -->
        <!-- Provider Details -->
        <div class="container my-4 oe_provider_details">
            <div class="row" itemscope="itemscope">
                <div t-if="not request.website.is_public_user()" class="col-lg-12 pb-4">
                    <a class="btn btn-primary o_add_provider" t-attf-href="/service/{{ provider.service_id.id}}/add_provider">
                        Add Provider
                    </a>
                </div>
                <div class="col-lg-3 col-md-4">
                    <div>
                        <img t-attf-src="/web/image/service.provider/#{provider.id}/avatar_1920" itemprop="image" class="img img-fluid w-100 mb-2 rounded-3 border" style="object-fit: cover;" alt="Coorge Tea Cafe" loading="lazy"/>
                    </div>
                </div>
                <div class="col-lg-9 col-md-8">
                    <div class="d-flex align-items-center flex-wrap mb-4">
                        <div class="flex-grow-1">
                            <span class="col-lg-12 text-muted">
                                <span t-field="provider.service_id"></span>
                            </span>
                            <h1 id="provider_name" itemprop="name" t-field="provider.name"></h1>
                        </div>
                    </div>
                    <div id="right_column">
                        <div t-out="provider.phone"></div>
                        <div t-out="provider.email"></div>
                        <div t-if="not request.website.is_public_user()">
                            <button type="button" class="btn btn-primary mt-2 oe_book_appointment">
                                <i class="fa fa-calendar"></i> Book Appointment
                            </button>
                        </div>
                        <div t-else="">
                            <h5>Please login to book and appointment</h5>
                            <button type="button" class="btn btn-primary">Sign In</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12" t-field="provider.profile_description">
                </div>
            </div>
        </div>
    </t>
</template>
</odoo>
