<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="website_local_services.AppointmentDialog">
        <Dialog size="'xl'" title.translate="Book Appointment">
            <div>
                <form class="o_form">
                    <div class="form-group">
                        <label for="appointment_date">Appointment Date</label>
                        <input type="datetime-local" id="appointment_date" name="appointment_date"
                            class="form-control"/>
                    </div>
                </form>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o-default-button"
                    t-on-click="props.onClickBook.bind(this)">
                    Save
                </button>
                <button t-if="props.onClose" class="btn btn-secondary"
                    t-on-click="props.onClose">
                    Close
                </button>
            </t>
        </Dialog>
    </t>

</templates>
